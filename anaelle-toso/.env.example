# ─────────────────────────────────────────────────────────────
# Site Anaëlle Toso — variables d'environnement
# Copier ce fichier en .env.local (développement) ou les saisir
# dans l'interface de l'hébergeur (production). Ne jamais committer de secrets.
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans / final) — utilisée pour le SEO, le sitemap et les partages
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Emplacements « À renseigner » visibles (true) ou masqués (false). Passer à false au lancement.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# ── Transmission des demandes de rendez-vous (au moins un canal en production) ──
# Adresse qui reçoit les demandes, et expéditeur (domaine vérifié chez le prestataire d'e-mail)
BOOKING_TO=anaelle@exemple.fr
BOOKING_FROM="Site Anaëlle Toso <rendez-vous@exemple.fr>"
# Envoyer un accusé de réception au propriétaire (true/false)
BOOKING_SEND_ACK=false

# Option 1 — Resend (https://resend.com) : recommandé
RESEND_API_KEY=

# Option 2 — SMTP (Gmail, OVH, o2switch, Brevo…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Option 3 — Webhook (Make, Zapier, n8n, Google Sheets…) : reçoit la demande en JSON
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# ── Anti-spam renforcé (facultatif) : Cloudflare Turnstile ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Instagram : publications récentes via l'API officielle (facultatif) ──
# Compte professionnel ou créateur + jeton longue durée (à renouveler tous les 60 jours)
INSTAGRAM_ACCESS_TOKEN=

# ── Espace d'administration Keystatic en production (mode GitHub) ──
# Dépôt contenant le site, au format propriétaire/depot
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Sous-dossier du site dans le dépôt (laisser vide si le site est à la racine du dépôt)
NEXT_PUBLIC_KEYSTATIC_PATH_PREFIX=anaelle-toso
# Générés par l'assistant Keystatic lors de la création de l'application GitHub
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
